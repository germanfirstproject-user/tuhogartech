# Configuración Flask
FLASK_ENV=development
FLASK_DEBUG=True

# Amazon Product Advertising API Credentials
# IMPORTANTE: Obtener credenciales en https://afiliados.amazon.es/

# Access Key de PA-API (20 caracteres)
PAAPI_ACCESS_KEY=

# Secret Key de PA-API (40 caracteres)
PAAPI_SECRET_KEY=

# Partner Tag - Tu ID de afiliado Amazon (ej: miafiliado-21)
PAAPI_PARTNER_TAG=

# Región de Amazon (opcional, por defecto eu-west-1)
PAAPI_REGION=eu-west-1

# Marketplace de Amazon (opcional, por defecto www.amazon.es)
PAAPI_MARKETPLACE=www.amazon.es
