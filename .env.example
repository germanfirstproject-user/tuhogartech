# ========================================
# CONFIGURACIÓN DE SUPABASE
# ========================================
# Obtén estos valores de tu proyecto en https://app.supabase.com/
# Ve a Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ========================================
# CONFIGURACIÓN DE ADMINISTRADOR
# ========================================
# Email del usuario que tendrá acceso al panel de administración
# Este email debe coincidir con el configurado en Supabase
# en la tabla admin_config o en los metadatos del usuario

NEXT_PUBLIC_ADMIN_EMAIL=admin@ejemplo.com

# ========================================
# CONFIGURACIÓN DEL SITIO
# ========================================
# URL base de tu sitio
# En desarrollo: http://localhost:3000
# En producción: https://tudominio.com

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ========================================
# NOTAS IMPORTANTES
# ========================================
# 1. Copia este archivo como .env.local para desarrollo
# 2. NO subas .env.local a Git (ya está en .gitignore)
# 3. En Netlify, configura estas variables en:
#    Site settings → Environment variables
# 4. Antes de deploy, cambia NEXT_PUBLIC_SITE_URL por tu dominio real
