# Variables de Entorno - Ejemplo

# Copia este archivo como .env.local y completa los valores

# ==========================================
# SUPABASE
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ==========================================
# SITIO WEB
# ==========================================
# URL de tu sitio (sin barra al final)
# Desarrollo: http://localhost:3000
# Producción: https://tudominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================
# GOOGLE ANALYTICS
# ==========================================
# Tu Measurement ID de Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XYYJ6ELDVR

# ==========================================
# ADMINISTRACIÓN
# ==========================================
# Email del administrador principal
NEXT_PUBLIC_ADMIN_EMAIL=tu@email.com

# ==========================================
# NOTAS:
# ==========================================
# 1. En desarrollo local, usa .env.local
# 2. En Netlify, configura estas variables en Site Settings → Environment Variables
# 3. Nunca subas archivos .env.local a Git (ya está en .gitignore)
# 4. NEXT_PUBLIC_ hace que la variable sea visible en el cliente (navegador)
