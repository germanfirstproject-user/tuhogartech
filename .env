# ========================================
# AMAZON PRODUCT ADVERTISING API (OPCIONAL - Futuro)
# ========================================
# Obtener en: https://afiliados.amazon.es/ y https://webservices.amazon.es/paapi5/documentation/
# NOTA: Estos campos son para uso futuro cuando tengas credenciales de PA-API

# Access Key de PA-API
PAAPI_ACCESS_KEY=

# Secret Key de PA-API
PAAPI_SECRET_KEY=

# Partner Tag (Tu ID de afiliado de Amazon)
PAAPI_PARTNER_TAG=

# URL del backend Flask para desarrollo (usado por /generar-excel)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Opcional: Configuración adicional
# PAAPI_REGION=eu-west-1
# PAAPI_MARKETPLACE=www.amazon.es

# ========================================
# INSTRUCCIONES
# ========================================
# 1. Copia este archivo como .env.local
# 2. Reemplaza las credenciales de Supabase con las tuyas
# 3. Las credenciales de PA-API son opcionales (para futuro)
# 4. NO subas .env.local a Git (ya está en .gitignore)
